---
<button type="button" id="theme-toggle" aria-label="Switch theme" class="f-orange2" style="background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;color:var(--nav-muted)">
  <svg id="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.6M12 18.9v2.6M4.4 4.4l1.85 1.85M17.75 17.75l1.85 1.85M2.5 12h2.6M18.9 12h2.6M4.4 19.6l1.85-1.85M17.75 6.25l1.85-1.85" />
  </svg>
  <svg id="theme-icon-light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" hidden>
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
  </svg>
</button>
<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    var iconDark = document.getElementById('theme-icon-dark');
    var iconLight = document.getElementById('theme-icon-light');
    function readTheme() {
      try { return localStorage.getItem('ptnext-theme') === 'light' ? 'light' : 'dark'; } catch (e) { return 'dark'; }
    }
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme === 'light' ? 'light' : 'dark');
      try { localStorage.setItem('ptnext-theme', theme); } catch (e) {}
      if (iconDark && iconLight) {
        iconDark.hidden = theme === 'light';
        iconLight.hidden = theme !== 'light';
      }
      if (btn) btn.setAttribute('aria-label', theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode');
    }
    applyTheme(readTheme());
    if (btn) btn.addEventListener('click', function () {
      applyTheme(readTheme() === 'light' ? 'dark' : 'light');
    });
  })();
</script>
