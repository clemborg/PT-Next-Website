---
import { tr, type Locale } from '@/lib/translations';
import { href } from '@/lib/routes';
import { css } from '@/lib/style';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const T = tr(locale);
---
<footer style={css({
  padding: '32px 64px', background: '#141416', borderTop: '1px solid #1e1e21',
  display: 'flex', flexDirection: 'column', gap: 18,
})}>
  <div style={css({ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 16 })}>
    <a
      href={href(locale, 'home')}
      class="f-orange3"
      style={css({
        fontFamily: "'Cormorant Garamond',serif", fontSize: 20, letterSpacing: '.06em',
        color: '#faf8f5', textDecoration: 'none',
      })}
    >
      PT&nbsp;Next
    </a>
    <div style={css({ fontSize: 12, color: '#6b665e', letterSpacing: '.04em', whiteSpace: 'nowrap' })}>
      {T('© 2026 PT Next, a Pac Team Group company')}
    </div>
  </div>
  <div style={css({
    display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap',
    gap: 16, paddingTop: 18, borderTop: '1px solid #1e1e21',
  })}>
    <div style={css({ fontSize: 12, color: '#6b665e', letterSpacing: '.02em' })}>
      205 Robin Road, Ste 200, Paramus, NJ 07652
    </div>
    <div style={css({ display: 'flex', alignItems: 'center', gap: 24 })}>
      <a href="tel:+12015995000" class="f-orange2" style={css({ fontSize: 12, color: '#6b665e', letterSpacing: '.02em', textDecoration: 'none' })}>+1 201 599 5000</a>
      <a href="mailto:info@ptnext.com" class="f-orange2" style={css({ fontSize: 12, color: '#6b665e', letterSpacing: '.02em', textDecoration: 'none' })}>info@ptnext.com</a>
      <a href="https://www.linkedin.com/company/pt-next" target="_blank" rel="noopener" class="f-orange2" style={css({ fontSize: 12, color: '#6b665e', letterSpacing: '.02em', textDecoration: 'none' })}>LinkedIn</a>
    </div>
  </div>
</footer>
