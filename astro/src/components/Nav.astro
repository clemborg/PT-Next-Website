---
import { tr, type Locale } from '@/lib/translations';
import { href, pages, type PageKey } from '@/lib/routes';
import { css } from '@/lib/style';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  locale: Locale;
  active: PageKey | '';
  pageKey: PageKey | null;
}

const { locale, active, pageKey } = Astro.props;
const T = tr(locale);

const NAV_ITEMS: { key: PageKey; label: string }[] = [
  { key: 'platform', label: 'Platform' },
  { key: 'deployments', label: 'Use Cases' },
  { key: 'proof', label: 'Proof' },
  { key: 'company', label: 'Company' },
  { key: 'faq', label: 'FAQ' },
];

const enHref = pageKey ? pages[pageKey].path.en : pages.home.path.en;
const frHref = pageKey ? pages[pageKey].path.fr : pages.home.path.fr;

const langLink = {
  fontFamily: 'Inter,sans-serif',
  fontSize: '11.5px',
  letterSpacing: '.08em',
  padding: '4px 2px',
  textDecoration: 'none',
};
---
<input
  type="checkbox"
  id="navtoggle"
  class="nav-toggle-input"
  aria-label="Toggle menu"
  style={css({ position: 'absolute', opacity: 0, width: 1, height: 1, margin: 0, pointerEvents: 'none' })}
/>
<header style={css({
  display: 'flex', alignItems: 'center', justifyContent: 'space-between',
  padding: '18px 40px', background: 'var(--bg)', opacity: 0.97, backdropFilter: 'blur(8px)',
  borderBottom: '1px solid var(--border)', position: 'sticky', top: 0, zIndex: 20, gap: 24,
})}>
  <a
    href={href(locale, 'home')}
    class="f-orange3"
    aria-label="PT Next home"
    style={css({ display: 'flex', alignItems: 'center', flexShrink: 0, textDecoration: 'none' })}
  >
    <img src="/images/ptnext-logo-dark.png" alt="PT Next" class="logo-dark" style={css({ height: 22, width: 'auto' })} />
    <img src="/images/ptnext-logo-light.png" alt="" class="logo-light" aria-hidden="true" style={css({ height: 22, width: 'auto' })} />
  </a>
  <nav class="site-nav" style={css({ display: 'flex', gap: 32, fontSize: '12.5px', color: 'var(--nav-muted)', letterSpacing: '.02em', flexShrink: 0 })}>
    {NAV_ITEMS.map((item) => (
      <a
        href={href(locale, item.key)}
        class="f-navlink"
        style={css({
          whiteSpace: 'nowrap', textDecoration: 'none',
          color: item.key === active ? 'var(--text)' : 'var(--nav-muted)',
        })}
      >
        {T(item.label)}
      </a>
    ))}
  </nav>
  <div style={css({ display: 'flex', alignItems: 'center', gap: 14, flexShrink: 0 })}>
    <ThemeToggle />
    <div style={css({ display: 'flex', alignItems: 'center', gap: 6 })}>
      <a
        href={enHref}
        class="f-orange2"
        lang="en"
        hreflang="en"
        aria-current={locale === 'en' ? 'true' : undefined}
        style={css({ ...langLink, ...(locale === 'en' ? { color: 'var(--text)', fontWeight: 600 } : { color: 'var(--nav-muted)' }) })}
      >
        EN
      </a>
      <span style={css({ fontSize: 11, color: 'var(--divider)' })}>|</span>
      <a
        href={frHref}
        class="f-orange2"
        lang="fr"
        hreflang="fr"
        aria-current={locale === 'fr' ? 'true' : undefined}
        style={css({ ...langLink, ...(locale === 'fr' ? { color: 'var(--text)', fontWeight: 600 } : { color: 'var(--nav-muted)' }) })}
      >
        FR
      </a>
    </div>
  </div>
  <label for="navtoggle" class="nav-toggle-label" aria-label="Open menu">☰</label>
  <a
    href="mailto:info@ptnext.com?subject=Pilot%20Request"
    class="f-white2 nav-cta"
    style={css({
      fontSize: '12.5px', color: '#0e0e0f', background: 'var(--orange)', padding: '10px 18px',
      letterSpacing: '.02em', fontWeight: 500, borderRadius: 1, flexShrink: 0,
      whiteSpace: 'nowrap', textDecoration: 'none',
    })}
  >
    {T('Request a pilot')}
  </a>
</header>
<nav
  class="mobile-drawer"
  style={css({
    display: 'none', flexDirection: 'column', position: 'fixed', top: 73, left: 0, right: 0,
    background: 'var(--bg-alt)', borderBottom: '1px solid var(--border)', zIndex: 19, padding: '8px 28px 20px',
  })}
>
  {NAV_ITEMS.map((item, i) => (
    <a
      href={href(locale, item.key)}
      style={css({
        padding: '14px 0', textDecoration: 'none', fontSize: 15,
        color: item.key === active ? 'var(--text)' : 'var(--nav-muted)',
        ...(i < NAV_ITEMS.length - 1 ? { borderBottom: '1px solid var(--border)' } : {}),
      })}
    >
      {T(item.label)}
    </a>
  ))}
  <a
    href="mailto:info@ptnext.com?subject=Pilot%20Request"
    class="f-white2"
    style={css({
      marginTop: 18, textAlign: 'center', fontSize: 14, color: '#0e0e0f',
      background: 'var(--orange)', padding: '13px 18px', letterSpacing: '.02em',
      fontWeight: 500, borderRadius: 1, textDecoration: 'none',
    })}
  >
    {T('Request a pilot')}
  </a>
</nav>
