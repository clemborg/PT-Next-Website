---
import { tr, type Locale } from '@/lib/translations';
import { href } from '@/lib/routes';
import { css } from '@/lib/style';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PedigreeStrip from '@/components/PedigreeStrip.astro';
import ContactForm from '@/components/ContactForm.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const T = tr(locale);
const imgBox = {
  aspectRatio: '1536/1024', borderRadius: 8, overflow: 'hidden',
  boxShadow: '0 30px 70px -25px rgba(0,0,0,.4)', border: '1px solid var(--border-2)',
};
const imgStyle = { width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'center' };
const ctaStyle = {
  fontSize: 13, color: 'var(--orange)', letterSpacing: '.03em', marginTop: 26, textDecoration: 'none', display: 'inline-block',
};
---
<div class="page">
      <Nav locale={locale} active="deployments" pageKey="deployments" />

      <section style={css({ padding: '110px 64px 90px', display: 'flex', flexDirection: 'column', alignItems: 'center', textAlign: 'center' })}>
        <div style={css({ fontSize: 12, letterSpacing: '.16em', textTransform: 'uppercase', color: 'var(--gold)', marginBottom: 20 })}>{T('Use Cases')}</div>
        <div style={css({ width: 42, height: 1, background: 'var(--orange)', marginBottom: 28 })} />
        <h1 class="hero-h1" style={css({ fontFamily: "'Cormorant Garamond',serif", fontWeight: 300, fontSize: 56, lineHeight: 1.1, maxWidth: 780 })}>
          {T('One platform, wherever a piece needs to be tracked.')}
        </h1>
      </section>

      <section style={css({ padding: '70px 64px', background: 'var(--bg-alt)', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 64, alignItems: 'center', borderTop: '1px solid var(--border)' })}>
        <div>
          <div style={css({ fontSize: 12, letterSpacing: '.14em', textTransform: 'uppercase', color: 'var(--gold)', marginBottom: 16 })}>{T('Boutiques')}</div>
          <h2 style={css({ fontFamily: "'Cormorant Garamond',serif", fontWeight: 300, fontSize: 38, lineHeight: 1.12 })}>{T('The everyday operation, made certain.')}</h2>
          <p style={css({ fontSize: 15, color: 'var(--warm)', lineHeight: 1.8, marginTop: 20, maxWidth: 440 })}>
            {T('Permanent RFID coverage across storage, display, and back of house. Counts, presentations, and conversion, tracked continuously as part of daily operations.')}
          </p>
          <a href={href(locale, 'home', 'boutique-pilot')} class="f-orange2" style={css(ctaStyle)}>
            {T('The 3-Month Boutique Pilot →')}
          </a>
        </div>
        <div style={css(imgBox)}>
          <img src="/images/deployments-boutique.png" alt="Boutique interior with gold-trimmed glass display cases showing jewelry pieces on velvet stands" style={css(imgStyle)} />
        </div>
      </section>

      <section style={css({ padding: '70px 64px', background: 'var(--bg)', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 64, alignItems: 'center' })}>
        <div class="mobile-image-last" style={css({ ...imgBox, order: 1 })}>
          <img src="/images/deployments-event.png" alt="Two people seated at an intimate table during a private high jewelry event viewing" style={css(imgStyle)} />
        </div>
        <div class="mobile-text-first" style={css({ order: 2 })}>
          <div style={css({ fontSize: 12, letterSpacing: '.14em', textTransform: 'uppercase', color: 'var(--gold)', marginBottom: 16 })}>{T('High jewelry events')}</div>
          <h2 style={css({ fontFamily: "'Cormorant Garamond',serif", fontWeight: 300, fontSize: 38, lineHeight: 1.12 })}>{T('Temporary coverage, full visibility.')}</h2>
          <p style={css({ fontSize: 15, color: 'var(--warm)', lineHeight: 1.8, marginTop: 20, maxWidth: 440 })}>
            {T('Rapid deployment for a single, time-contained event. Real-time location and presentation tracking on the pieces that matter most, with the white-glove event capability Pac Team Group already brings to these rooms.')}
          </p>
          <a href={href(locale, 'home', 'event-pilot')} class="f-orange2" style={css(ctaStyle)}>
            {T('The High Jewelry Event Pilot →')}
          </a>
        </div>
      </section>

      <section style={css({ padding: '70px 64px', background: 'var(--bg-alt)', display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 64, alignItems: 'center', borderTop: '1px solid var(--border)', borderBottom: '1px solid var(--border)' })}>
        <div>
          <div style={css({ fontSize: 12, letterSpacing: '.14em', textTransform: 'uppercase', color: 'var(--gold)', marginBottom: 16 })}>{T('Repair centers')}</div>
          <h2 style={css({ fontFamily: "'Cormorant Garamond',serif", fontWeight: 300, fontSize: 38, lineHeight: 1.12 })}>{T('Custody, never in question.')}</h2>
          <p style={css({ fontSize: 15, color: 'var(--warm)', lineHeight: 1.8, marginTop: 20, maxWidth: 440 })}>
            {T('A piece in service is a piece at risk of being unaccounted for. Argos tracks chain of custody from intake to return, across every stage of repair and restoration.')}
          </p>
          <a href="mailto:info@ptnext.com?subject=Repair%20Center%20Coverage" class="f-orange2" style={css(ctaStyle)}>
            {T('Talk to us about repair center coverage →')}
          </a>
        </div>
        <div style={css(imgBox)}>
          <img src="/images/deployments-repair.png" alt="Jewelry repair technicians working at wooden workbenches with precision tools" style={css(imgStyle)} />
        </div>
      </section>

      <PedigreeStrip locale={locale} borderTop={false} />

      <ContactForm
        heading={T("Find the right starting point for your operation.")}
        subheading={T("Start with a single event, or a 3-month boutique pilot.")}
        inputBg="var(--bg-alt)"
        linkHref={href(locale, 'home', 'event-pilot')}
        linkLabel={T("See how a pilot works")}
        thankYouHref={href(locale, 'thankyou')}
        labels={{
          name: T('Name'),
          email: T('Email'),
          message: T('Tell us about your boutique or event'),
          submit: T('Request a pilot'),
          sending: T('Sending…'),
          error: T('Something went wrong. Please email us directly at info@ptnext.com.'),
        }}
      />

      <Footer locale={locale} />
    </div>
