---
import { pages, type PageKey, SITE_ORIGIN } from '@/lib/routes';
import type { Locale } from '@/lib/translations';
import Analytics from '@/components/Analytics.astro';
import JsonLd from '@/components/JsonLd.astro';
import '@/styles/global.css';

interface Props {
  pageKey: PageKey;
  locale: Locale;
  noindex?: boolean;
  jsonLd?: boolean;
}

const { pageKey, locale, noindex = false, jsonLd = false } = Astro.props;
const page = pages[pageKey];
const canonical = SITE_ORIGIN + page.path[locale];
const ogImage = `${SITE_ORIGIN}/og-image.png`;
const ogLocale = locale === 'fr' ? 'fr_FR' : 'en_US';
const ogAltLocale = locale === 'fr' ? 'en_US' : 'fr_FR';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title[locale]}</title>
    <meta name="description" content={page.description[locale]} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={SITE_ORIGIN + page.path.en} />
    <link rel="alternate" hreflang="fr" href={SITE_ORIGIN + page.path.fr} />
    <link rel="alternate" hreflang="x-default" href={SITE_ORIGIN + page.path.en} />

    <meta property="og:site_name" content="PT Next" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={page.title[locale]} />
    <meta property="og:description" content={page.description[locale]} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title[locale]} />
    <meta name="twitter:description" content={page.description[locale]} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function(){try{if(localStorage.getItem('ptnext-theme')==='light')document.documentElement.setAttribute('data-theme','light');}catch(e){}})();
    </script>

    {jsonLd && <JsonLd />}
  </head>
  <body>
    <slot />
    <Analytics locale={locale} />
  </body>
</html>
