# Copy this file to .env.local (dev) or set as a build-time env var on
# the host (production). Analytics is gated on this value AND visitor
# consent — GA4 only loads after the user clicks Accept on the banner.

# GA4 Measurement ID, e.g. G-XXXXXXXXXX (find it in GA4 Admin > Data Streams)
NEXT_PUBLIC_GA_ID=
